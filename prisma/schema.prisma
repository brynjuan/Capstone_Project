generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // HAPUS BARIS URL DI SINI! Cukup sisakan provider saja.
}

// 1. TAMBAHKAN ENUM ROLE BARU
enum Role {
  SUPERADMIN
  ADMIN
  KIOSK
}

// ... (Biarkan sisa kode di bawahnya persis seperti sebelumnya)

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   
  
  // 2. TAMBAHKAN ROLE DAN REGION (DAERAH)
  role      Role     @default(ADMIN)
  region    String?  @db.VarChar(100) // Contoh: "Palu", "Donggala". Jika Superadmin, ini bisa kosong/null.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processedLogs VisitorLog[] 

  @@map("admins")
}

model VisitorLog {
  id             String      @id @default(uuid())
  fullName       String      @db.VarChar(100)  // Nama PIC (Pengunjung)
  phoneNumber    String?     @db.VarChar(20)   // Nope PIC
  institution    String?     @db.VarChar(100)  // Nama Customer / Instansi
  internetNumber String?     @db.VarChar(50)
  address        String?     @db.Text          // Alamat
  category       String?     @db.VarChar(100)  // Kategori Kunjungan
  purpose        String      @db.Text          // Maksud dan Tujuan
  hostName       String?     @db.VarChar(100)  // Petugas yang dituju
  photoUrl       String?     @db.Text
  pin            String?     @unique @db.VarChar(10) // Tambahkan ini
  
  // 3. TAMBAHKAN KOLOM REGION (DAERAH) UNTUK LOG KUNJUNGAN
  region         String      @default("Palu") @db.VarChar(100)

  // 4. TELEGRAM INTEGRATION
  tgMsgId        String?     @db.VarChar(50)
  tgChatId       String?     @db.VarChar(50)
  tgCompletedMsgId String?   @db.VarChar(50) // Untuk pesan di grup laporan selesai

  // ========================================================
  // SISTEM ANTREAN CERDAS (SMART QUEUE)
  status           VisitStatus @default(PENDING) // Default saat daftar adalah PENDING
  checkInTime      DateTime    @default(now())   // Waktu mulai mengantri di lobi
  serviceStartTime DateTime?                     // Waktu dipanggil / mulai dilayani CS
  checkOutTime     DateTime?                     // Waktu selesai dilayani / batal
  // ========================================================

  rating         Int?      // Tanda tanya (?) artinya opsional
  
  adminId        String?   
  processedBy    Admin?    @relation(fields: [adminId], references: [id])
  
  @@map("visitor_logs")
}

// Enum baru untuk mengakomodasi alur kerja CS
enum VisitStatus {
  PRE_REGISTER
  PENDING      // Sedang menunggu antrean
  ON_PROGRESS  // Sedang dilayani CS di meja
  SUCCESS      // Pelayanan selesai dengan sukses
  CANCELLED    // Pelayanan dibatalkan/tamu pulang duluan
}

model KioskSetting {
  // 4. ID DISESUAIKAN UNTUK MENAMPUNG NAMA DAERAH
  id        String   @id @default("global") // Nanti id ini akan diisi nama daerah seperti "Palu" atau "Tolitoli"
  isBusy    Boolean  @default(false)
  message   String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("kiosk_settings")
}